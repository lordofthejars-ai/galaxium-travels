{
  "title": "Open AI Dashboard",
  "tags": [
    "Quarkus",
    "LangChain4j",
    "OpenAI",
    "AI",
    "Micrometer"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Token Usage Over Time",
      "targets": [
        {
          "expr": "llm_token_input_count_tokens_total{modelName=\"open-ai\"}"
        },
        {
          "expr": "llm_token_output_count_tokens_total{modelName=\"open-ai\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Token Count",
      "targets": [
        {
          "expr": "llm_token_count_tokens_total{modelName=\"open-ai\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Estimated Token Cost (USD)",
      "targets": [
        {
          "expr": "((llm_token_input_count_tokens_total{modelName=\"open-ai\"}/1000000)*0.0005) + ((llm_token_output_count_tokens_total{modelName=\"open-ai\"}/1000000)*0.0005)"
        }
      ]
    }
  ],
  "schemaVersion": 41,
  "version": 1
}